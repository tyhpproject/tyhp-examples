<?tyhp
namespace Labels;

class Cli {
    public function run(array<int, string> $args): int {
        string $command = 'help';
        if (isset($args[1]) && $args[1]->isNotEmpty()) {
            $command = $args[1]->toLower();
        }

        if ($command === 'label') {
            return $this->label($args);
        }
        if ($command === 'help' || $command === '--help') {
            $this->help();
            return 0;
        }

        echo "Unknown command: {$command}\n\n";
        $this->help();
        return 1;
    }

    private function label(array<int, string> $args): int {
        if (!isset($args[2]) || !$args[2]->trim()->matches('/^[+]?\d+$/')) {
            echo "Usage: label <id> <title>\n";
            return 1;
        }
        string $title = $this->join($args, 3);
        if ($title->isEmpty()) {
            echo "Usage: label <id> <title>\n";
            return 1;
        }
        Note $note = new Note($args[2]->trim()->__toInt(), $title);
        echo $note->label() . "\n";
        return 0;
    }

    private function join(array<int, string> $args, int $start): string {
        array<int, string> $parts = [];
        int $count = \count($args);
        int $i = $start;
        while ($i < $count) {
            $part = $args[$i]->trim();
            if ($part->isNotEmpty()) {
                $parts[] = $part;
            }
            $i++;
        }
        return \implode(' ', $parts);
    }

    private function help(): void {
        echo "Prints a note label. Labeled requires a Record that implements Titled.\n\n";
        echo "  label <id> <title>   Print #id title\n";
    }
}
