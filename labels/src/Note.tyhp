<?tyhp
namespace Labels;

class Record {
    public function __construct(
        private int $id,
        private string $title,
    ): void {}

    public function getId(): int {
        return $this->id;
    }

    public function getTitle(): string {
        return $this->title;
    }
}

interface Titled {
    public function getTitle(): string;
}

trait Labeled extends Record implements Titled {
    public function label(): string {
        return '#' . (string)$this->getId() . ' ' . $this->getTitle();
    }
}

class Note extends Record implements Titled {
    use Labeled;
}
