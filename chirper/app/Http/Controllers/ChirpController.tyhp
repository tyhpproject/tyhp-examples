<?tyhp

namespace App\Http\Controllers;

use App\Data\Chirp;
use App\Data\ChirpContext;
use App\Models\User;
use Illuminate\Contracts\View\View as ViewContract;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\App;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Redirect;
use Illuminate\Support\Facades\View;

class ChirpController extends Controller
{
    /**
     * Display a listing of the resource.
     */
    public function index(): ViewContract
    {
        $db = $this->chirps();
        array<int, Chirp> $chirps = $db->chirps
            ->with(fn ($chirp) => $chirp->user)
            ->latest()
            ->take(50)
            ->all();

        return View::make('home', ['chirps' => $chirps], []);
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create(): void
    {
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'message' => 'required|string|max:255',
        ], [
            'message.required' => 'Please write something to chirp!',
            'message.max' => 'Chirps must be 255 characters or less.',
        ]);

        $message = $this->stringValue($validated, 'message');
        $account = Auth::user();
        if ($account instanceof User) {
            $chirp = new Chirp();
            $chirp->message = $message;
            $chirp->userId = $this->accountId($account);
            $db = $this->chirps();
            $db->chirps->add($chirp);
            $db->save();

            return Redirect::to('/', 302, [], null)->with('success', 'Your chirp has been posted!');
        }

        App::abort(403, 'Unauthorized', []);
    }

    /**
     * Display the specified resource.
     */
    public function show(string $id): void
    {
        (void)$id;
    }

    /**
     * Show the form for editing the specified resource.
     */
    public function edit(string $chirp): ViewContract
    {
        $row = $this->findChirp($chirp);
        $this->denyUnlessOwner($row);

        return View::make('chirps.edit', ['chirp' => $row], []);
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(Request $request, string $chirp): RedirectResponse
    {
        $row = $this->findChirp($chirp);
        $this->denyUnlessOwner($row);

        $validated = $request->validate([
            'message' => 'required|string|max:255',
        ], []);

        $row->message = $this->stringValue($validated, 'message');
        $this->chirps()->save();

        return Redirect::to('/', 302, [], null)->with('success', 'Chirp updated!');
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(string $chirp): RedirectResponse
    {
        $row = $this->findChirp($chirp);
        $this->denyUnlessOwner($row);

        $db = $this->chirps();
        $db->chirps->remove($row);
        $db->save();

        return Redirect::to('/', 302, [], null)->with('success', 'Chirp deleted!');
    }

    private function chirps(): ChirpContext
    {
        $db = App::make(ChirpContext::class, []);
        if ($db instanceof ChirpContext) {
            return $db;
        }

        throw new \RuntimeException('Expected a chirp context.');
    }

    private function findChirp(string $id): Chirp
    {
        if (\ctype_digit($id) === false) {
            App::abort(404, 'Chirp not found', []);
            throw new \RuntimeException('Chirp not found.');
        }

        $found = $this->chirps()->chirps->find((int) $id);
        if ($found instanceof Chirp) {
            return $found;
        }

        App::abort(404, 'Chirp not found', []);
        throw new \RuntimeException('Chirp not found.');
    }

    private function denyUnlessOwner(Chirp $chirp): void
    {
        if ($this->currentUserOwns($chirp) === false) {
            App::abort(403, 'Unauthorized', []);
        }
    }

    private function currentUserOwns(Chirp $chirp): bool
    {
        $actorId = Auth::id();
        if (\is_int($actorId)) {
            return $chirp->userId === $actorId;
        }
        if (\is_string($actorId) && \ctype_digit($actorId)) {
            return $chirp->userId === (int) $actorId;
        }

        return false;
    }

    private function accountId(User $account): int
    {
        $id = $account->getKey();
        if (\is_int($id)) {
            return $id;
        }
        if (\is_string($id) && \ctype_digit($id)) {
            return (int) $id;
        }

        throw new \RuntimeException('Expected a user id.');
    }

    private function stringValue(array $validated, string $key): string
    {
        $value = $validated[$key] ?? null;
        if (\is_string($value)) {
            return $value;
        }

        throw new \InvalidArgumentException('Expected a string.');
    }
}
