<?tyhp 

namespace App\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

class Chirp extends Model
{
    public function __construct(array<string, mixed> $attributes = [])
    {
        // Laravel's $fillable is untyped. PHP 8.5 rejects a typed redeclaration.
        $this->fillable = [
            'message',
        ];
        parent::__construct($attributes);
    }

    public function user(): BelongsTo<User, static>
    {
        return $this->belongsTo<User>(User::class);
    }
}
