<?tyhp 

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Foundation\Auth\User as Authenticatable;
use Illuminate\Notifications\Notifiable;

class User extends Authenticatable
{
    use HasFactory<\Database\Factories\UserFactory>, Notifiable;

    public function __construct(array<string, mixed> $attributes = [])
    {
        // Laravel's $fillable and $hidden are untyped. PHP 8.5 rejects a typed
        // redeclaration, so set the trait properties instead of redeclaring them.
        $this->fillable = [
            'name',
            'email',
            'password',
        ];
        $this->hidden = [
            'password',
            'remember_token',
        ];
        parent::__construct($attributes);
    }

    protected function casts(): array<string, \Stringable|string>
    {
        return [
            'email_verified_at' => 'datetime',
            'password' => 'hashed',
        ];
    }
}
