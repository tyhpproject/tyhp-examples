        "tyhpdef/symfony-var-exporter": "7.4.18"
    },
    "config": {
        "allow-plugins": {
            "tyhp/core": false,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "scripts": {
        "tyhp": "vendor/bin/tyhp",
        "post-autoload-dump": [
            "vendor/bin/tyhp --install-binary"
        ]
    },
    "scripts-descriptions": {
        "tyhp": "Forward extra args to the Tyhp CLI (e.g. composer tyhp build)"
    },
    "autoload": {
        "psr-4": {
            "App\\": ["app/", "build/App/"],
            "Database\\Factories\\": "build/Database/Factories/",
            "Database\\Seeders\\": "build/Database/Seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "build/Tests/"
        }
    }
}
