{
    "name": "app/config-tool",
    "description": "Environment-file CLI written in Tyhp",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "tyhp/core": "805.0.3",
        "vlucas/phpdotenv": "^5.6",
        "tyhp/async": "805.0.3",
        "tyhp/decimal": "805.0.3",
        "tyhp/lambda": "805.0.3"
    },
    "require-dev": {
        "tyhpdef/php": "0.0.3",
        "tyhpdef/vlucas-phpdotenv": "5.7.0",
        "tyhp/compiler": "805.1.2-beta.3",
        "tyhpdef/symfony-polyfill-ctype": "1.37.0"
    },
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "scripts": {
        "tyhp": "vendor/bin/tyhp",
        "post-autoload-dump": [
            "vendor/bin/tyhp --install-binary",
            "vendor/bin/tyhp generate_tyhpdef --vendor"
        ]
    },
    "scripts-descriptions": {
        "tyhp": "Forward extra args to the Tyhp CLI (e.g. composer tyhp build)"
    },
    "autoload": {
        "psr-4": {
            "ConfigTool\\": "build/ConfigTool/"
        }
    }
}
