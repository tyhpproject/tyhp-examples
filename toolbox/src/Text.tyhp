<?tyhp
namespace Toolbox;

class Text {
    public static function join(array<int, string> $args, int $start): string {
        array<int, string> $parts = [];
        int $count = \count($args);
        int $i = $start;
        while ($i < $count) {
            $part = $args[$i]->trim();
            if ($part->isNotEmpty()) {
                $parts[] = $part;
            }
            $i++;
        }
        return \implode(' ', $parts);
    }
}
